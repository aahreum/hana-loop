# Supabase
#
# 이 프로젝트는 모든 DB 접근을 API Route(서버)에서만 수행한다.
# 브라우저 클라이언트(supabase.ts)를 사용하지 않으므로 NEXT_PUBLIC_ 키는 필요 없다.
# 신규 Supabase 키 체계 (publishable / secret):
#   - Publishable key (sb_publishable_...): 구 anon key. 브라우저용, RLS 정책 적용.
#   - Secret key      (sb_secret_...):      구 service_role key. 서버 전용, RLS 우회.
# → SUPABASE_SERVICE_ROLE_KEY에 Secret key (sb_secret_...) 를 입력.
# 절대 클라이언트 컴포넌트에 노출 금지.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
